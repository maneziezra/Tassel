{
  "expo": {
    "name": "Tassel",
    "slug": "tassel",
    "version": "2.9.2",
    "scheme": "tassel",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.tassel.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ke.tassel.app",
      "versionCode": 13,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "react-native-fast-tflite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E3A2A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tassel uses the camera to photograph crop leaves and detect diseases.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tassel lets you choose a leaf photo from your gallery to check for diseases."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tassel uses your location for the local weather forecast, blight risk, mapping your fields and finding nearby agro-dealers."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#137A5A"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-background-task"
    ]
  }
}
