{
  "expo": {
    "name": "CropGuard AI",
    "slug": "CropGuard-AI",
    "version": "2.1.0",
    "scheme": "cropguard-ai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#137A5A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.CropGuardAI",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "react-native-fast-tflite",
      [
        "expo-camera",
        {
          "cameraPermission": "CropGuard uses the camera to photograph crop leaves and detect diseases.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CropGuard lets you choose a leaf photo from your gallery to check for diseases."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CropGuard uses your location for the local weather forecast, blight risk, mapping your fields and finding nearby agro-dealers."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#137A5A"
        }
      ],
      "expo-font"
    ]
  }
}
